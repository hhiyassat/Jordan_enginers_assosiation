# =============================================================================
# ESP-v2 · frontend environment example
# =============================================================================
# Copy this file to `frontend/.env` before running `npm run dev`.
# All values shown here are safe defaults for LOCAL DEVELOPMENT ONLY.
#
# The frontend has TWO kinds of environment variables:
#   • VITE_* baked into the browser bundle at build time.
#   • Server-time variables consumed by the Vite dev server
#     (never sent to the browser — e.g. VITE_DEV_PROXY_TARGET).
#
# Changing any VITE_* requires restarting `npm run dev`.
# =============================================================================

# --- Browser-side API base URL ------------------------------------------------
# The browser fetches this base + `/auth/login`, `/auth/me`, etc.
# Prefer a same-origin path so cookies + CSRF flow cleanly through the
# Vite dev server:
#
#   VITE_API_BASE_URL=/api/v1
#
# The default `http://localhost:8080/api/v1` bypasses the dev proxy and
# talks straight to Laravel; use it when you're serving the frontend
# without Vite (e.g. built artefact under nginx).
VITE_API_BASE_URL=http://localhost:8080/api/v1

# --- Vite dev-server proxy target (server-time only; NOT bundled) -------------
# Vite proxies `/api/*` requests to this address during `npm run dev`.
# The default matches the docker-compose port mapping in
# `docker-compose.yml` (app service published as `8080:80`).
#
# Override examples:
#   VITE_DEV_PROXY_TARGET=http://127.0.0.1:9000     # backend on a custom port
#   VITE_DEV_PROXY_TARGET=http://esp-remote:80      # backend on a remote host
#
# Changing this variable requires stopping + restarting `npm run dev`.
VITE_DEV_PROXY_TARGET=http://localhost:8080

# --- Third-party integration key (JORD-*) -------------------------------------
VITE_INTEGRATION_KEY=your_integration_key_here

# --- CAPTCHA feature flag (frontend widget) ----------------------------------
# The CAPTCHA is DISABLED by default in local development so the login
# page doesn't require solving a challenge on every sign-in.
#
# INVARIANT: this MUST match the backend's `CAPTCHA_ENABLED` in the same
# environment. When they disagree the login page hides the widget while
# the backend still requires the captcha payload and returns HTTP 422
# with `errors.captcha_answer` — the user sees an unexplained rejection.
#
# For LOCAL development:
#   frontend:  VITE_CAPTCHA_ENABLED=false
#   backend:   CAPTCHA_ENABLED=false  (see docker-compose.override.yml.example)
#
# For STAGING/PRODUCTION set BOTH to `true`.
VITE_CAPTCHA_ENABLED=false
