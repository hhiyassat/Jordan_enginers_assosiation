APP_NAME="ESP v2 Platform"
APP_ENV=production
APP_KEY=base64:CHANGE_THIS_IN_PRODUCTION_SECRET_STORE
APP_DEBUG=false
APP_URL=https://esp.jea.org.jo

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=esp_v2_prod
DB_USERNAME=esp_db_user
DB_PASSWORD=MUST_BE_PROVIDED_BY_OPS

BROADCAST_DRIVER=log
CACHE_STORE=redis
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=MUST_BE_PROVIDED_BY_OPS
REDIS_PORT=6379

AWS_ACCESS_KEY_ID=MUST_BE_PROVIDED_BY_OPS
AWS_SECRET_ACCESS_KEY=MUST_BE_PROVIDED_BY_OPS
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=esp-v2-production-uploads

SANCTUM_EXPIRATION_MINUTES=480

GSB_ALLOWED_IPS=192.168.1.100,192.168.1.101
NASHMI_SIGNING_SECRET=MUST_BE_PROVIDED_BY_OPS
NASHMI_INTEGRATION_KEY=MUST_BE_PROVIDED_BY_OPS
CAPTCHA_ENABLED=true
